// =====================================================================
// firestore.rules – CivicResolve Security Rules
// Deploy with: firebase deploy --only firestore:rules
// =====================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isCitizen()  { return isSignedIn() && getUserRole() == 'citizen';  }
    function isOfficer()  { return isSignedIn() && getUserRole() == 'officer';  }
    function isAdmin()    { return isSignedIn() && getUserRole() == 'admin';    }
    function isOfficerOrAdmin() { return isOfficer() || isAdmin(); }

    // ── /users/{uid} ──────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone signed in can read their own profile; admins can read all
      allow read:   if request.auth.uid == uid || isAdmin();
      // Only the user themselves can create their profile (on register)
      allow create: if request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['uid','name','email','role','createdAt'])
                    && request.resource.data.role in ['citizen','officer','admin'];
      // Users can update their own name/email; admins can update role
      allow update: if (request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','uid']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── /complaints/{complaintId} ─────────────────────────────────────
    match /complaints/{complaintId} {
      // Citizens can read only their own complaints; officers/admins read all
      allow read: if isOfficerOrAdmin()
                  || (isCitizen() && resource.data.citizenId == request.auth.uid);

      // Any signed-in citizen/officer/admin can create a complaint
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll([
                         'id','title','category','description','location',
                         'status','department','citizenName','citizenId',
                         'createdAt','lastUpdated'
                       ])
                    && request.resource.data.status == 'Submitted';

      // Officers and admins can update status/comments
      // Citizens cannot update complaints (read-only for them)
      allow update: if isOfficerOrAdmin()
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['id','citizenId','createdAt']);

      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
